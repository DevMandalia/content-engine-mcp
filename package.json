{
  "name": "content-engine-mcp",
  "version": "0.1.1",
  "description": "Personal content engine for MCP agents: idea to newsletter and social drafts, locally.",
  "mcpName": "io.github.content-engine/content-engine-mcp",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "content-engine-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine.js"
  },
  "files": [
    "dist",
    "themes",
    "schemas",
    "scripts/build.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "pack:mcpb": "tsx scripts/pack-mcpb.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "keywords": [
    "mcp",
    "mcpb",
    "mcp-server",
    "model-context-protocol",
    "content",
    "newsletter",
    "twitter",
    "instagram",
    "linkedin",
    "claude-desktop"
  ],
  "homepage": "https://github.com/DevMandalia/content-engine-mcp#readme",
  "bugs": {
    "url": "https://github.com/DevMandalia/content-engine-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevMandalia/content-engine-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "nodemailer": "^7.0.6",
    "twitter-text": "3.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/twitter-text": "^3.1.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
