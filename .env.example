# Copy to .env locally. Never commit real keys. The MCP server reads these
# from the process environment (set them in your MCP client config `env` block).

# Resend adapter (https://resend.com) — optional
RESEND_API_KEY=
RESEND_FROM=Content Engine <you@example.com>

# SMTP adapter (Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
